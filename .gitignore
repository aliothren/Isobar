# Generated analysis artifacts (regenerable) -- but KEEP the ENGLISH writeup +
# result figures so the documentation renders. The Chinese SUMMARY.md is a local
# working copy (not pushed); bulk CSV/JSON, per-pair comm dumps, and the mapper
# output dirs stay ignored too.
workspace/analysis/*
!workspace/analysis/SUMMARY.en.md
!workspace/analysis/SUMMARY.Extn.md
!workspace/analysis/FIXLIST.en.md
!workspace/analysis/SEARCH_SPEC.en.md
!workspace/analysis/PROGRESS.md
!workspace/analysis/ANCHORS.md
!workspace/analysis/MATERIALS.md
!workspace/analysis/baseline_traces.md
!workspace/analysis/ladder_v0.md
!workspace/analysis/ergodicity.md
!workspace/analysis/METRICS.md
!workspace/analysis/search_setting_design.md
!workspace/analysis/phase_diagram_isobar_caption.md
!workspace/analysis/*.png
!workspace/analysis/op_breakdown/
workspace/analysis/op_breakdown/*
!workspace/analysis/op_breakdown/*.png
!workspace/analysis/op_breakdown/op_breakdown.md

