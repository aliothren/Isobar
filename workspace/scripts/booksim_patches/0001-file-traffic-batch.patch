+// Isobar patch (workspace/scripts/booksim_patches/): exact
+// per-pair BATCH traffic from a file of "<src> <dst> <count>" lines.
+// dest(src) serves the expanded destination list round-robin
+// (deterministic); count(src) is the per-source packet quota that
+// BatchTrafficManager picks up in place of the uniform batch_size.
+class FileTrafficPattern : public TrafficPattern {
+private:
+  vector<vector<int> > _dests;
+  vector<int> _next;
+public:
+  FileTrafficPattern(int nodes, string const & filename);
+  virtual int dest(int source);
+  int count(int source) const;
+};
