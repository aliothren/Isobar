+FileTrafficPattern::FileTrafficPattern(int nodes, string const & filename)
+  : TrafficPattern(nodes), _dests(nodes), _next(nodes, 0)
+{
+  ifstream f(filename.c_str());
+  if(!f) {
+    cout << "Error: cannot open traffic file " << filename << endl;
+    exit(-1);
+  }
+  int s, d, c;
+  while(f >> s >> d >> c) {
+    if(s < 0 || s >= nodes || d < 0 || d >= nodes || c < 0) {
+      cout << "Error: bad traffic file entry: " << s << " " << d << " " << c << endl;
+      exit(-1);
+    }
+    for(int i = 0; i < c; ++i) {
+      _dests[s].push_back(d);
+    }
+  }
+}
+
+int FileTrafficPattern::dest(int source)
+{
+  assert((source >= 0) && (source < _nodes));
+  if(_dests[source].empty()) {
+    return source;   // zero-quota source: never actually issued
+  }
+  int d = _dests[source][_next[source] % (int)_dests[source].size()];
+  _next[source]++;
+  return d;
+}
+
+int FileTrafficPattern::count(int source) const
+{
+  return (int)_dests[source].size();
+}
